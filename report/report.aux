\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Posterior approximation comparison. Blue histograms: MCMC samples. Orange curves: VI Gaussian approximation. Red dashed lines: true parameter values. VI captures the posterior mode accurately but significantly underestimates variance for $\mu $ due to the mean-field restriction.}}{13}{figure.caption.13}\protected@file@percent }
\newlabel{fig:posterior}{{3}{13}{Posterior approximation comparison. Blue histograms: MCMC samples. Orange curves: VI Gaussian approximation. Red dashed lines: true parameter values. VI captures the posterior mode accurately but significantly underestimates variance for $\mu $ due to the mean-field restriction}{figure.caption.13}{}}
